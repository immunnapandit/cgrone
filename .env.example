# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# In production these are set in Vercel → Settings → Environment Variables.

# Resend API key — https://resend.com/api-keys
# A "Sending access" key is enough; it does not need full access.
RESEND_API_KEY=

# Sender identity. The domain must be verified in Resend
# (https://resend.com/domains) before it will send.
# Until a domain is verified, Resend only accepts `onboarding@resend.dev`
# as the sender, and only delivers to your own Resend account address.
MAIL_FROM=CGR ONE <noreply@cgrone.com>

# Where contact-form and newsletter submissions are delivered.
# Defaults to info@cgrone.com if unset.
CONTACT_TO_EMAIL=info@cgrone.com
